{
  // One Worker: serves the built app from ./dist and handles /api/* itself.
  "name": "ledger",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Serve at ledger.<your-subdomain>.workers.dev, and nowhere else: no per-version
  // preview URLs, which would be extra public copies talking to the real database.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Requests to /api/* always go to the Worker; everything else is a static file.
    "run_worker_first": ["/api/*"],
    // Any other path that isn't a real file falls back to index.html (single page app).
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // Sign-up closes once this many accounts exist. Two of you = 2.
    "MAX_USERS": "2",
    // PBKDF2 work factor (10000-100000). Measured locally, one hash costs about
    // 0.23 ms of CPU per 1000 iterations. The Workers Free plan allows 10 ms of CPU
    // per request, and changing a password hashes twice, so 20000 (~4.6 ms per hash)
    // keeps every request under the limit. On the Paid plan, raise it to 100000.
    // Existing passwords move to this value the next time each person signs in.
    "PBKDF2_ITERATIONS": "20000"
  },
  "d1_databases": [
    {
      // The code reads the database as env.DB, so this must stay "DB".
      "binding": "DB",
      "database_name": "ledger",
      "database_id": "d0eaf71d-6d38-4bf1-a7f0-2379710bce52",
      "migrations_dir": "migrations"
    }
  ]
}
